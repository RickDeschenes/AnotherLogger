<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet package metadata -->
		<PackageId>AnotherLogger</PackageId>
		<Version>2.0.4</Version>
		<Authors>RickDeschenes</Authors>
		<Company>RickDeschenes</Company>
		<Description>Lightweight file-based logger library.</Description>

		<!-- Create package on build -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>false</IncludeSymbols>

		<PackageTags>logging;logger;file-logger</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/RickDeschenes/AnotherLogger</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/RickDeschenes/AnotherLogger</PackageProjectUrl>

		<!-- Ensure packages are emitted into project-root artifacts folder -->
		<PackageOutputPath>$(MSBuildProjectDirectory)/artifacts</PackageOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="certs\" />
	</ItemGroup>

</Project>
